# Vercel/serverless: use the Supabase Shared Transaction Pooler (port 6543).
# Custom-role username format: ROLE.PROJECT_REF.
# Copy the exact pooler host from Supabase Connect; do not guess the cluster index.
# Percent-encode reserved characters in the password.
DATABASE_URL=postgresql://strategicuser_readonly.vznwvenzjzccvtqorhas:CHANGE_ME@YOUR_POOLER_HOST:6543/postgres?sslmode=require
API_TITLE=StrategicPlan API
API_VERSION=1.0.0
CORS_ORIGINS=http://localhost:5173

# Server-only proxy key must equal Netlify STRATEGIC_PROXY_KEY (Functions scope).
PROXY_SHARED_KEY=GENERATE_A_RANDOM_SERVER_ONLY_SECRET
# Enable on deployed environments after applying the abuse-control migration.
ABUSE_CONTROLS_ENABLED=true
